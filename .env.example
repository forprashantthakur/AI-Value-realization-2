# PostgreSQL connection string (required in production). Vercel Postgres / Neon / Supabase all work.
# If unset, the app runs on a temporary in-memory store (local development only — data is lost on restart).
DATABASE_URL="postgresql://avp:avp@localhost:5432/avp?schema=public"
# Secret for signing session cookies — at least 32 random characters. Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-of-32-chars-or-more"
# Set to "false" to disable self sign-up (new users can then only join by invitation link).
ALLOW_SIGNUP=true
# Optional LLM provider for the AI Value Advisor narrative layer (numbers always come from the engine)
ADVISOR_LLM_PROVIDER=none
